# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# MCP HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional remote authentication token. Leave empty for local-only deployments.
MCP_AUTH_TOKEN=

# Build runtime
BUILDER_MAX_REPAIR_CYCLES=3
BUILDER_COMMAND_TIMEOUT=120
BUILDER_STATE_DIR=/tmp/mcp-coding-agent-state
